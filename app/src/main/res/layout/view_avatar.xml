<?xml version="1.0" encoding="utf-8"?>
<!-- Story-style avatar: gradient ring, a surface-coloured gap, then the circular photo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ring"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_story_ring"
    android:padding="2.5dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_story_gap"
        android:padding="2.5dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PhotoFeed.Circle" />
    </FrameLayout>
</FrameLayout>
